#----------------------------DESEQ ANALYSIS---------------------------------


#Check NA NA
sum(is.na(filtered_counts))


#Discar rows where sum=0
UCMSC_Paired_filtered_counts_nonzero<- filtered_counts[rowSums(filtered_counts[ , -1]) > 0, ]

#Filtering low gene expression: at leat 10 cpm in 5 samples
keep <- rowSums(UCMSC_Paired_filtered_counts_nonzero >= 10) >= 5
UCMSC_Paired_filtered_counts_nonzero_counts10_5samples <- UCMSC_Paired_filtered_counts_nonzero[keep, ]
View(UCMSC_Paired_filtered_counts_nonzero_counts10_5samples)



# Keep the filtered table asncount_matrix
counts_matrix <- UCMSC_Paired_filtered_counts_nonzero_counts10_5samples

# Metadata preparation
        # Extracting columns information
         sample_names <- colnames(counts_matrix)

        # Create metadata
sample_info <- data.frame(
  sample_id = sample_names,
  condition = ifelse(grepl("^B", sample_names), "AGA", "SGA"),  # B = AGA, S = SGA
  twin_pair = as.factor(gsub("[BS]", "", sample_names)),  # Extraer número del par
  row.names = sample_names
)

print(sample_info)

# Establish the AGA group as a reference. (SGA vs AGA is + if SGA > AGA)
sample_info$condition <- sample_info$condition <- factor(sample_info$condition, levels = c("AGA", "SGA"))
sample_info$twin_pair <- factor(sample_info$twin_pair)


#Create the DESe2 object with pair design

dds <- DESeqDataSetFromMatrix(
  countData = counts_matrix,
  colData = sample_info,
  design = ~ twin_pair + condition
)

print(paste("Retained genes after filtering:", nrow(dds)))

#DEG analysis

     #DESeq2 execution
dds <- DESeq(dds)

     # Extracting results
res <- results(dds, contrast = c("condition", "SGA", "AGA"))

     # Check result`s summary
summary(res)

# Sorting the results by their p-adj value (FDR)
res_ordered <- res[order(res$padj), ]

# Check top 10 genes
print(head(res_ordered, 10))

#Export the DESeq2 results
write.table(as.data.frame(res_ordered),file = "UCMSC_deseq2_results.txt",sep=";",quote=FALSE,row.names=TRUE,col.names=TRUE)

#Export normalized counts

normalized_counts <- counts(dds, normalized = TRUE)
write.table(normalized_counts, 
            file = "UCMSC_normalized_counts.txt",sep="\t",quote=FALSE,row.names=TRUE,col.names=TRUE,dec=".")


