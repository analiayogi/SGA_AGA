# Count significant genes
significant_genes <- subset(res_ordered, padj < 0.05 & abs(log2FoldChange) > 1)
cat("Significant genes (padj < 0.05, |log2FC| > 1):", nrow(significant_genes), "\n")

# Create custom color vector
keyvals <- ifelse(
  res$log2FoldChange < -1 & res$pvalue < 0.05, '#0066CC',     # Downregulated (blue)
  ifelse(res$log2FoldChange > 1 & res$pvalue < 0.05, '#CC0000', # Upregulated (red)
         ifelse(abs(res$log2FoldChange) > 1, 'gray70',          # FC only
                'gray80')))                                       # Not significant

keyvals[is.na(keyvals)] <- 'gray80'
names(keyvals)[keyvals == '#CC0000'] <- 'Upregulated'
names(keyvals)[keyvals == '#0066CC'] <- 'Downregulated'
names(keyvals)[keyvals == 'gray70'] <- 'Log2 FC'
names(keyvals)[keyvals == 'gray80'] <- 'Not significant'

# Create volcano plot
volcano_plot <- EnhancedVolcano(res,
