  )

# Save volcano plot
ggsave(file.path(OUTPUT_DIR, "UCMSC_volcano_plot.png"), 
       plot = volcano_plot, width = 10, height = 9, dpi = 300, bg = "white")

ggsave(file.path(OUTPUT_DIR, "UCMSC_volcano_plot.pdf"), 
