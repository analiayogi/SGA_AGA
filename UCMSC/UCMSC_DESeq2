#-----------------------PCA-----------------------

# Data transformation for visualization 
vsd <- vst(dds, blind = FALSE)

# Data for PCA
pcaData <- plotPCA(vsd, intgroup = c("condition", "twin_pair"), returnData = TRUE)
pca <- prcomp(t(assay(vsd)))
pc_scores <- as.data.frame(pca$x[, 1:3]) 

# Metadata integration: condition and pair twin 
pc_scores$condition <- colData(vsd)$condition
pc_scores$twin_pair <- colData(vsd)$twin_pair
pc_scores$name <- rownames(pc_scores)
pc_scores$shape <- ifelse(pc_scores$condition == "AGA", "circle", "diamond")
pc_scores$label <- pc_scores$condition



# Reorder the pair twin numbers 1 -> 6, 2 -> 1, 3 -> 2, 4 -> 3, 6 -> 4, 7 -> 5
pair_mapping <- c("1" = "6", "2" = "1", "3" = "2", "4" = "3", "6" = "4", "7" = "5")

# Apply the mapping to pair_twin 
pc_scores$twin_pair_display <- pair_mapping[as.character(pc_scores$twin_pair)]

# Convert to factor with levels sorted by new numbering 
pc_scores$twin_pair_display <- factor(pc_scores$twin_pair_display, levels = c("1", "2", "3", "4", "5", "6"))

# Create labels that include the pair twin number  
pc_scores$label <- paste0("P", pc_scores$twin_pair_display, "-", pc_scores$condition)

paleta <- brewer.pal(nlevels(pc_scores$twin_pair), "Set2")

#PCA figure
fig <- plot_ly()

for (pair in levels(pc_scores$twin_pair_display)) {
  aga <- subset(pc_scores, twin_pair_display == pair & condition == "AGA")
  sga <- subset(pc_scores, twin_pair_display == pair & condition == "SGA")
  color_idx <- which(levels(pc_scores$twin_pair_display) == pair)
  fig <- add_trace(
    fig,
    data = aga,
    x = ~PC1, y = ~PC2, z = ~PC3,
    type = 'scatter3d', mode = 'markers+text',
    marker = list(symbol = 'circle', size = 10, color = paleta[color_idx]),
    name = paste0("Pair twin ", pair),  
    text = ~label, textposition = 'top center', textfont = list(size = 13),
    showlegend = FALSE, 
    legendgroup = paste0("Pair twin ", pair)
  )
  fig <- add_trace(
    fig,
    data = sga,
    x = ~PC1, y = ~PC2, z = ~PC3,
    type = 'scatter3d', mode = 'markers+text',
    marker = list(symbol = 'diamond', size = 10, color = paleta[color_idx]),
    name = paste0("Pair twin ", pair),  
    text = ~label, textposition = 'top center', textfont = list(size = 13),
    showlegend = FALSE,
    legendgroup = paste0("Pair twin ", pair)
  )
}


fig <- layout(
  fig,
  title = list(
    text = "UCMSC 3D PCA",
    y = 0.95,
    font = list(size = 48)
  ),
  scene = list(
    domain = list(x = c(0, 1)),
    xaxis = list(title = "PC1"),
    yaxis = list(title = "PC2"),
    zaxis = list(title = "PC3")
  )
)

