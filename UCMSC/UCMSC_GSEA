# Filtering the data by the terms 
filter_gene_sets <- function(gene_sets, terms) {
  pattern <- paste(terms, collapse = "|")
  filtered <- gene_sets[grepl(pattern, gene_sets$gs_name, ignore.case = TRUE), ]
  return(filtered)
}

