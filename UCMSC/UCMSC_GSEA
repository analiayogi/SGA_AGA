# Making pathways more readable

clean_pathway_names <- function(pathway_names, max_chars_per_line = 35) {
  cleaned <- gsub("^(GOBP_|GOCC_|GOMF_|KEGG_|REACTOME_)", "", pathway_names)
  cleaned <- gsub("_", " ", cleaned)
  cleaned <- str_to_title(cleaned)
  cleaned <- sapply(cleaned, function(name) {
    if(nchar(name) > max_chars_per_line) {
      words <- unlist(strsplit(name, " "))
      if(length(words) > 1) {
        cumulative_length <- cumsum(nchar(words) + c(0, rep(1, length(words)-1)))
        split_point <- which(cumulative_length <= max_chars_per_line)
        if(length(split_point) > 0) {
          split_point <- max(split_point)
          line1 <- paste(words[1:split_point], collapse = " ")
          line2 <- paste(words[(split_point+1):length(words)], collapse = " ")
          result <- paste(line1, line2, sep = "\n")
        } else {
          mid_point <- ceiling(nchar(name)/2)
          space_positions <- gregexpr(" ", name)[[1]]
          if(space_positions[1] != -1) {
            best_split <- space_positions[which.min(abs(space_positions - mid_point))]
            line1 <- substr(name, 1, best_split - 1)
            line2 <- substr(name, best_split + 1, nchar(name))
            result <- paste(line1, line2, sep = "\n")
          } else {
            result <- name 
          }
        }
      } else {
        mid_point <- ceiling(nchar(name)/2)
        line1 <- substr(name, 1, mid_point)
        line2 <- substr(name, mid_point + 1, nchar(name))
        result <- paste(line1, line2, sep = "\n")
      }
    } else {
      result <- name
    }
    return(result)
  }, USE.NAMES = FALSE)
  
  return(cleaned)
}

