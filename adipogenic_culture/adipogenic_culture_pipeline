# Function: paired expression plot
# SGA (diamond) on left, AGA (circle) on right, pairs connected by dashed lines
create_paired_plot <- function(gene_name, dds, res, pair_mapping, pair_colors) {
  
  d       <- plotCounts(dds, gene = gene_name,
                        intgroup = c("condition", "twin_pair"), returnData = TRUE)
  d$Group <- d$condition
  d$Pair  <- factor(pair_mapping[as.character(d$twin_pair)],
                    levels = c("1","2","3","4","5"))
  d$count <- log2(d$count + 1)   # log2 transform
  
  p_value <- res[gene_name, "pvalue"]
  p_text  <- if (is.na(p_value)) "p = NA" else
    if (p_value < 0.001) "p < 0.001" else
      sprintf("p = %.2f", p_value)
  
  y_max    <- max(d$count)
  y_range  <- max(d$count) - min(d$count)
  bracket_y <- y_max + y_range * 0.08
  p_text_y  <- y_max + y_range * 0.18
  
  ggplot(d, aes(x = Group, y = count)) +
    geom_line(aes(group = Pair), color = "gray50", linewidth = 0.8,
              linetype = "dashed", alpha = 0.8) +
    geom_point(aes(color = Pair, shape = Group), size = 4.5, stroke = 1.2, alpha = 0.9) +
    scale_color_manual(values = pair_colors) +
    scale_shape_manual(values = c("SGA" = 18, "AGA" = 16)) +
    scale_x_discrete(limits = c("SGA", "AGA")) +
    scale_y_continuous(expand = expansion(mult = c(0.05, 0.25))) +
    annotate("segment", x = 1, xend = 2, y = bracket_y, yend = bracket_y,
             linewidth = 0.5, color = "black") +
    annotate("segment", x = 1, xend = 1, y = bracket_y,
             yend = bracket_y - y_range * 0.03, linewidth = 0.5, color = "black") +
    annotate("segment", x = 2, xend = 2, y = bracket_y,
             yend = bracket_y - y_range * 0.03, linewidth = 0.5, color = "black") +
    annotate("text", x = 1.5, y = p_text_y, label = p_text,
             size = 4, fontface = "italic", color = "black") +
    theme_classic(base_size = 11) +
    theme(
      plot.title    = element_text(size = 12, face = "bold.italic", hjust = 0.5),
      axis.title.x  = element_blank(),
      axis.title.y  = element_text(size = 11, color = "black"),
      axis.text.x   = element_text(size = 11, face = "bold", color = "black"),
      axis.text.y   = element_text(size = 10.5, color = "black"),
      axis.line     = element_line(linewidth = 0.5, color = "black"),
      legend.position = "none"
    ) +
    labs(y = expression(Log[2]*"(normalized counts + 1)")) +
    ggtitle(gene_name)
}

