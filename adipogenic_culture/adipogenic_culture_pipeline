# Save volcano plot
ggsave(file.path(OUTPUT_DIR, "Adipocyte_volcano_plot.png"), 
       plot = volcano_plot, width = 10, height = 9, dpi = 300, bg = "white")

ggsave(file.path(OUTPUT_DIR, "Adipocyte_volcano_plot.pdf"), 
       plot = volcano_plot, device = "pdf", width = 10, height = 9)

ggsave(file.path(OUTPUT_DIR, "Adipocyte_volcano_plot.tiff"), 
       plot = volcano_plot, device = "tiff", width = 10, height = 9, 
       dpi = 300, compression = "lzw")

cat("✓ Volcano plot saved\n")

