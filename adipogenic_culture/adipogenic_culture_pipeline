write.csv(summary_table, file.path(GSEA_DIR, "GSEA_GOBP_Top_Summary.csv"), row.names = FALSE)

# ── Figure E: Leading edge heatmap (3 panels) ────────────────────────────────
#    LEFT  = Paired Difference SGA(n) - AGA(n)  +  % consistency
#    MID   = Individual Z-score by sample
#    RIGHT = Group mean (SGA vs AGA)  +  mean-delta barplot

create_le_heatmap <- function(pw_name, fgsea_row, dds_obj, output_prefix, show_plot = TRUE) {
  
  # Extract leading edge genes present in dds
  if (is.list(fgsea_row$leadingEdge)) le_genes <- fgsea_row$leadingEdge[[1]]
  else le_genes <- unlist(strsplit(as.character(fgsea_row$leadingEdge), ", "))
  le_genes <- le_genes[le_genes %in% rownames(dds_obj)]
  if (length(le_genes) < 3) { cat("  Warning: too few genes for", pw_name, "\n"); return(NULL) }
  
  clean_name <- clean_pathway_names(pw_name, 55)
  cat("  ->", clean_name, "(n =", length(le_genes), ")\n")
  
  # Z-score matrix
  vsd_le      <- vst(dds_obj, blind = FALSE)
  mat_z       <- t(scale(t(assay(vsd_le)[le_genes, , drop = FALSE])))
  si          <- as.data.frame(colData(dds_obj))
  si$pair_display <- factor(PAIR_MAPPING[as.character(si$twin_pair)],
                            levels = c("1","2","3","4","5"))
  
  nes   <- fgsea_row$NES
  pares <- unique(si$twin_pair)
  
  # Consistency: % of pairs with concordant expression change
  consistency <- sapply(le_genes, function(g) {
    count <- 0
    for (par in pares) {
      sga <- rownames(si)[si$twin_pair == par & si$condition == "SGA"]
      aga <- rownames(si)[si$twin_pair == par & si$condition == "AGA"]
      if (length(sga) == 1 && length(aga) == 1) {
        if (nes > 0 && mat_z[g, sga] > mat_z[g, aga]) count <- count + 1
        if (nes < 0 && mat_z[g, sga] < mat_z[g, aga]) count <- count + 1
      }
    }
    count / length(pares) * 100
  })
  
  gene_order  <- names(sort(consistency, decreasing = TRUE))
  mat_z       <- mat_z[gene_order, , drop = FALSE]
  consistency <- consistency[gene_order]
  
  # Shared aesthetics — uses PAIR_COLORS from CONFIGURATION
  pair_colors <- PAIR_COLORS
  cond_colors <- c("SGA" = "gray20", "AGA" = "gray70")
  heat_colors <- colorRamp2(c(-2, 0, 2), c("#4575B4", "white", "#D73027"))
  
  # ── LEFT: Paired Difference ──────────────────────────────────────────────
  pares_ord <- sort(unique(as.character(si$twin_pair)))
  mat_diff  <- matrix(NA, nrow = length(gene_order), ncol = length(pares_ord),
                      dimnames = list(gene_order, NULL))
  for (i in seq_along(pares_ord)) {
    par   <- pares_ord[i]
    sga_s <- rownames(si)[si$twin_pair == par & si$condition == "SGA"]
    aga_s <- rownames(si)[si$twin_pair == par & si$condition == "AGA"]
    if (length(sga_s) == 1 && length(aga_s) == 1)
      mat_diff[, i] <- mat_z[, sga_s] - mat_z[, aga_s]
  }
  col_ord_diff  <- order(as.numeric(PAIR_MAPPING[pares_ord]))
  mat_diff      <- mat_diff[, col_ord_diff, drop = FALSE]
  pares_display <- PAIR_MAPPING[pares_ord[col_ord_diff]]
  colnames(mat_diff) <- paste0("P", pares_display)
  
  ht_left <- Heatmap(
    mat_diff, name = "dZ-score", col = heat_colors,
    cluster_rows = FALSE, cluster_columns = FALSE,
    top_annotation = HeatmapAnnotation(
      `Twin Pair` = factor(pares_display, levels = c("1","2","3","4","5")),
      col = list(`Twin Pair` = pair_colors),
      simple_anno_size = unit(3, "mm"),
      show_annotation_name = FALSE, show_legend = FALSE),
    right_annotation = rowAnnotation(
      `% pairs` = anno_text(paste0(round(consistency), "%"),
                            gp = gpar(fontsize = 6), width = unit(0.8, "cm")),
      show_annotation_name = FALSE),
    show_row_names = TRUE, row_names_side = "left",
    row_names_gp    = gpar(fontsize = 7, fontface = "italic"),
    column_names_gp = gpar(fontsize = 7), column_names_rot = 45,
    column_title    = "Paired Difference\nSGA(n) - AGA(n)",
    column_title_gp = gpar(fontsize = 9, fontface = "bold"),
    width  = unit(ncol(mat_diff) * 8, "mm"),
    height = unit(nrow(mat_diff) * CELL_HEIGHT_MM, "mm"),
    border = TRUE)
  
  # ── MIDDLE: Individual expression ────────────────────────────────────────
  si$order  <- ifelse(si$condition == "SGA", 1, 2)
  col_ord   <- rownames(si)[order(si$order, si$pair_display)]
  mat_z_mid <- mat_z[, col_ord, drop = FALSE]
  si_ord    <- si[col_ord, ]
  colnames(mat_z_mid) <- paste0(ifelse(si_ord$condition == "SGA", "S", "A"), si_ord$pair_display)
  
  ht_mid <- Heatmap(
    mat_z_mid, name = "Z-score", col = heat_colors,
    cluster_rows = FALSE, cluster_columns = FALSE,
    column_split = factor(si_ord$condition, levels = c("SGA","AGA")),
    column_gap   = unit(2, "mm"),
    top_annotation = HeatmapAnnotation(
      Condition   = si_ord$condition,
      `Twin Pair` = si_ord$pair_display,
      col = list(Condition = cond_colors, `Twin Pair` = pair_colors),
      simple_anno_size = unit(3, "mm"),
      show_annotation_name = FALSE, show_legend = TRUE),
    show_row_names  = FALSE,
    column_names_gp = gpar(fontsize = 7), column_names_rot = 45,
    column_title    = "Individual expression",
    column_title_gp = gpar(fontsize = 9, fontface = "bold"),
    width  = unit(ncol(mat_z_mid) * 6, "mm"),
    height = unit(nrow(mat_z_mid) * CELL_HEIGHT_MM, "mm"),
    border = TRUE)
  
  # ── RIGHT: Group mean + delta barplot ────────────────────────────────────
  sga_s     <- rownames(si)[si$condition == "SGA"]
  aga_s     <- rownames(si)[si$condition == "AGA"]
  mean_sga  <- rowMeans(mat_z[, sga_s, drop = FALSE])
  mean_aga  <- rowMeans(mat_z[, aga_s, drop = FALSE])
  mat_means <- cbind(SGA = mean_sga, AGA = mean_aga)
  diff_means <- mean_sga - mean_aga
  
  ht_right <- Heatmap(
    mat_means, name = "Mean Z", col = heat_colors,
    cluster_rows = FALSE, cluster_columns = FALSE,
    top_annotation = HeatmapAnnotation(
      Label = anno_text(c("SGA","AGA"),
                        gp = gpar(fontsize = 10, fontface = "bold"),
                        just = "center", rot = 0, height = unit(5, "mm")),
      Condition = c("SGA","AGA"),
      col = list(Condition = cond_colors),
      simple_anno_size = unit(3, "mm"),
      show_legend = FALSE, show_annotation_name = FALSE, gap = unit(1, "mm")),
    right_annotation = rowAnnotation(
      `Mean d` = anno_barplot(diff_means,
                              gp = gpar(fill = ifelse(diff_means > 0, "#D73027", "#4575B4")),
                              width = unit(1.5, "cm"), border = FALSE,
                              axis_param = list(gp = gpar(fontsize = 6))),
      show_annotation_name = FALSE),
    show_row_names  = FALSE,
    column_names_gp = gpar(fontsize = 8),
    column_title    = "Group mean Difference",
    column_title_gp = gpar(fontsize = 9, fontface = "bold"),
    width  = unit(ncol(mat_means) * 10, "mm"),
    height = unit(nrow(mat_means) * CELL_HEIGHT_MM, "mm"),
    border = TRUE)
  
  # ── Combine and save ─────────────────────────────────────────────────────
  ht_list    <- ht_left + ht_mid + ht_right
  title_text <- paste0("GO:BP ", clean_name,
                       " (", length(gene_order), " leading-edge genes)\n",
                       ifelse(nes > 0, "Up", "Down"), " in SGA",
                       "  |  NES = ", sprintf("%.2f", nes),
                       "  |  FDR = ", sprintf("%.2e", fgsea_row$padj))
  w <- 18
  h <- max(5, length(gene_order) * 0.15 + 3)
  
  .draw <- function() draw(ht_list,
                           column_title = title_text, column_title_gp = gpar(fontsize = 11, fontface = "bold"),
                           gap = unit(4, "mm"), heatmap_legend_side = "right",
                           annotation_legend_side = "right", padding = unit(c(10, 10, 10, 15), "mm"))
  
  if (show_plot) { .draw(); Sys.sleep(0.5) }
  
  png(paste0(output_prefix, ".png"), width = w, height = h, units = "in", res = 300)
  .draw(); dev.off()
  pdf(paste0(output_prefix, ".pdf"), width = w, height = h)
  .draw(); dev.off()
  
  return(TRUE)
}

