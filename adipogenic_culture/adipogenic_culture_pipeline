  annotate("text", x = 0, y = 2, label = "Pair 4", size = 4, color = "#FF7F00", hjust = 0) +
  annotate("text", x = 0, y = 1, label = "Pair 5", size = 4, color = "#984EA3", hjust = 0) +
  xlim(-0.5, 2) + ylim(0, 6) +
