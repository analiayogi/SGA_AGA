# RNA-SEQ ANALYSIS PIPELINE: ADIPOGENIC CULTURE SAMPLES
# Comparison: SGA vs AGA
# Design: Paired analysis (5 twin pairs, 10 samples total)
#
# Note: 5 of the original 6 UCMSC twin pairs underwent adipogenic
#       differentiation 
#
# Pipeline outline:
#   1. Data preprocessing and gene annotation (ENSEMBL to Gene Symbol)
#   2. Differential expression analysis (DESeq2)
#   3. Principal Component Analysis (3D PCA)
#   4. Volcano Plot visualization
#   5. Gene Set Enrichment Analysis (GSEA) - GO:BP
#   6. Gene expression plots: DLK1, PPARG, FABP4
#
# Author: Analia Yogi
# Date:   January 2026
# Data:   DDBJ accession PRJDB40126

#=========================================================================================================================================================================================
# Clear environment
rm(list = ls())
gc()


# CONFIGURATION


OUTPUT_DIR <- "Adipocyte_analysis_results"

if (!dir.exists(OUTPUT_DIR)) {
  dir.create(OUTPUT_DIR, recursive = TRUE)
  cat("Directory created:", OUTPUT_DIR, "\n")
}

# Twin pair mapping (original -> display)
# Renumbers pairs for cleaner visualization
# Adipocyte dataset uses pairs 2,3,4,6,7 (pair 1 not differentiated)
PAIR_MAPPING <- c("2" = "1", "3" = "2", "4" = "3", "6" = "4", "7" = "5")

# Unified color palette for twin pairs (used in PCA, heatmap and gene expression plots)
PAIR_COLORS <- c("1" = "#E41A1C",   # red
                 "2" = "#377EB8",   # blue
                 "3" = "#4DAF4A",   # green
                 "4" = "#FF7F00",   # orange
                 "5" = "#984EA3")   # purple
N_PAIRS <- 5

# Set seed for reproducibility
set.seed(42)

# LOAD LIBRARIES

library(biomaRt)
library(dplyr)
library(ggplot2)
library(DESeq2)
library(pheatmap)
library(RColorBrewer)
library(EnhancedVolcano)
library(plotly)
library(patchwork)
library(fgsea)
library(msigdbr)
library(stringr)
library(ComplexHeatmap)
library(circlize)
library(grid)
library(gridExtra)
library(cowplot)
library(htmlwidgets)
library(extrafont)

#=========================================================================================================================================================================================
# 1. DATA PREPROCESSING

# Load raw counts

raw_counts <- read.table("adipocyte_raw_counts_paired.csv",
                         header      = TRUE,
                         row.names   = 1,
                         sep         = ";",
                         check.names = FALSE)

# Extract ENSEMBL IDs
ensembl_ids <- rownames(raw_counts)
cat("Total genes:", length(ensembl_ids), "\n")

# Remove version numbers from ENSEMBL IDs (e.g., ENSG00000000003.15 -> ENSG00000000003)
ensembl_ids_clean <- gsub("\\.\\d+$", "", ensembl_ids)
cat("IDs with version numbers removed:", sum(ensembl_ids != ensembl_ids_clean), "\n")

# Connect to biomaRt
cat("Connecting to biomaRt...\n")
mart <- useMart("ensembl", dataset = "hsapiens_gene_ensembl")

# Retrieve annotations
cat("Retrieving annotations...\n")
annotations <- getBM(
  attributes = c("ensembl_gene_id", "hgnc_symbol", "gene_biotype", "description"),
  filters    = "ensembl_gene_id",
  values     = ensembl_ids_clean,
  mart       = mart
)

# Create mapping table
mapping_table <- data.frame(
  ensembl_id_original = ensembl_ids,
  ensembl_id_clean    = ensembl_ids_clean,
  gene_symbol         = NA,
  gene_biotype        = NA,
  description         = NA,
  has_symbol          = FALSE,
  is_protein_coding   = FALSE,
  stringsAsFactors    = FALSE
)

# Add annotation information
for (i in 1:nrow(mapping_table)) {
  ensembl_id       <- mapping_table$ensembl_id_clean[i]
  annotation_match <- annotations[annotations$ensembl_gene_id == ensembl_id, ]
  
  if (nrow(annotation_match) > 0) {
    annotation_match <- annotation_match[1, ]
    mapping_table$gene_symbol[i]       <- annotation_match$hgnc_symbol
    mapping_table$gene_biotype[i]      <- annotation_match$gene_biotype
    mapping_table$description[i]       <- annotation_match$description
    mapping_table$has_symbol[i]        <- annotation_match$hgnc_symbol != ""
    mapping_table$is_protein_coding[i] <- annotation_match$gene_biotype == "protein_coding"
  }
}

# Filter for protein-coding genes with valid symbols
valid_genes        <- mapping_table[mapping_table$has_symbol &
                                      mapping_table$is_protein_coding, ]
valid_genes        <- valid_genes[!is.na(valid_genes$has_symbol), ]

cat("Protein-coding genes with valid symbols:", nrow(valid_genes), "\n")

# Remove duplicates (keep first occurrence)
valid_genes_unique <- valid_genes[!duplicated(valid_genes$gene_symbol), ]
cat("Unique genes after removing duplicates:", nrow(valid_genes_unique), "\n")

# Filter counts data
filtered_counts           <- raw_counts[valid_genes_unique$ensembl_id_original, ]
rownames(filtered_counts) <- valid_genes_unique$gene_symbol

# Verify no duplicates remain
if (sum(duplicated(rownames(filtered_counts))) == 0) {
  cat("✓ No duplicates in final data\n")
} else {
  cat("✗ Duplicates still present - check code\n")
}

# SAMPLE STRUCTURE VERIFICATION

sample_names <- colnames(filtered_counts)

# Identify paired structure
# B = AGA (Appropriate for Gestational Age)
# S = SGA (Small for Gestational Age)
pairs_detected <- data.frame(
  sample      = sample_names,
  condition   = ifelse(grepl("^B", sample_names), "AGA", "SGA"),
  pair_number = as.numeric(gsub("[BS]", "", sample_names)),
  stringsAsFactors = FALSE
)

print(pairs_detected)

# Verify complete pairs
pairs_summary <- table(pairs_detected$pair_number, pairs_detected$condition)
cat("\nPair summary:\n")
print(pairs_summary)

# SAVE PREPROCESSING RESULTS

write.csv(mapping_table,
          file.path(OUTPUT_DIR, "Adipocyte_ensembl_to_symbol_mapping.csv"),
          row.names = FALSE)

write.csv(filtered_counts,
          file.path(OUTPUT_DIR, "Adipocyte_counts_with_gene_symbols.csv"),
          row.names = TRUE)

write.csv(pairs_detected,
          file.path(OUTPUT_DIR, "Adipocyte_sample_structure.csv"),
          row.names = FALSE)

#=========================================================================================================================================================================================
# 2. DIFFERENTIAL EXPRESSION ANALYSIS (DESeq2)

# DATA FILTERING

# Remove genes with zero counts across all samples
filtered_counts_nonzero <- filtered_counts[rowSums(filtered_counts) > 0, ]
cat("Genes after removing zero-count rows:", nrow(filtered_counts_nonzero), "\n")

# Filter low expression genes
# Criterion: at least 10 counts in at least 5 samples
keep          <- rowSums(filtered_counts_nonzero >= 10) >= 5
counts_matrix <- filtered_counts_nonzero[keep, ]

# CREATE DESeq2 OBJECT

# Create sample metadata
sample_info <- data.frame(
  sample_id = colnames(counts_matrix),
  condition = ifelse(grepl("^B", colnames(counts_matrix)), "AGA", "SGA"),
  twin_pair = as.factor(gsub("[BS]", "", colnames(counts_matrix))),
  row.names = colnames(counts_matrix)
)

# Set AGA as reference level (so positive log2FC = higher in SGA)
sample_info$condition <- factor(sample_info$condition, levels = c("AGA", "SGA"))
sample_info$twin_pair <- factor(sample_info$twin_pair)

cat("\nSample metadata:\n")
print(sample_info)

# Create DESeq2 object with paired design
# Design: ~ twin_pair + condition
# This accounts for within-pair variation (twin_pair as blocking factor)
dds <- DESeqDataSetFromMatrix(
  countData = counts_matrix,
  colData   = sample_info,
  design    = ~ twin_pair + condition
)

# RUN DESeq2

cat("\n=== RUNNING DESeq2 ===\n")

dds <- DESeq(dds)

# Extract results
res <- results(dds, contrast = c("condition", "SGA", "AGA"))

# Results summary
cat("\nResults summary:\n")
summary(res)

# Order by adjusted p-value
res_ordered <- res[order(res$padj), ]

# Top 10 differentially expressed genes
cat("\nTop 10 most significant genes:\n")
print(head(res_ordered, 10))

# EXPORT DESeq2 RESULTS

write.csv(as.data.frame(res_ordered),
          file.path(OUTPUT_DIR, "Adipocyte_deseq2_results.csv"),
          row.names = TRUE)

write.table(as.data.frame(res_ordered),
            file.path(OUTPUT_DIR, "Adipocyte_deseq2_results.txt"),
            sep = "\t", dec = ".", row.names = TRUE, col.names = NA, quote = FALSE)

# Export normalized counts
normalized_counts <- counts(dds, normalized = TRUE)
write.table(normalized_counts,
            file.path(OUTPUT_DIR, "Adipocyte_normalized_counts.txt"),
            sep = "\t", quote = FALSE, row.names = TRUE, col.names = TRUE, dec = ".")

#=========================================================================================================================================================================================
# 3. PRINCIPAL COMPONENT ANALYSIS (3D PCA)

# Variance stabilizing transformation
vsd <- vst(dds, blind = FALSE)

# PCA
pca <- prcomp(t(assay(vsd)))
pc_scores <- as.data.frame(pca$x[, 1:3])

# Calculate variance explained
percentVar <- round(100 * pca$sdev^2 / sum(pca$sdev^2), 1)

# Add metadata
pc_scores$condition <- colData(vsd)$condition
pc_scores$twin_pair <- colData(vsd)$twin_pair
pc_scores$name      <- rownames(pc_scores)

# Apply pair mapping for display
pc_scores$twin_pair_display <- factor(
  PAIR_MAPPING[as.character(pc_scores$twin_pair)],
  levels = c("1", "2", "3", "4", "5")
)

# Color palette for 5 pairs (from CONFIGURATION)
pair_colors_pca <- unname(PAIR_COLORS)

# Create 3D plot
fig <- plot_ly()

for (pair in levels(pc_scores$twin_pair_display)) {
  aga       <- subset(pc_scores, twin_pair_display == pair & condition == "AGA")
  sga       <- subset(pc_scores, twin_pair_display == pair & condition == "SGA")
  color_idx <- which(levels(pc_scores$twin_pair_display) == pair)
  
  # AGA (circles)
  fig <- add_trace(fig, data = aga, x = ~PC1, y = ~PC2, z = ~PC3,
                   type = 'scatter3d', mode = 'markers',
                   marker = list(symbol = 'circle', size = 16, color = pair_colors_pca[color_idx],
                                 line = list(color = 'black', width = 7), opacity = 1),
                   name = paste0("Twin pair ", pair), showlegend = FALSE,
                   legendgroup = paste0("pair_", pair),
                   hovertemplate = paste0('Twin pair ', pair, '<br>AGA<br>',
                                          'PC1: %{x:.2f}<br>PC2: %{y:.2f}<br>PC3: %{z:.2f}<extra></extra>'))
  
  # SGA (diamonds)
  fig <- add_trace(fig, data = sga, x = ~PC1, y = ~PC2, z = ~PC3,
                   type = 'scatter3d', mode = 'markers',
                   marker = list(symbol = 'diamond', size = 16, color = pair_colors_pca[color_idx],
                                 line = list(color = 'black', width = 7), opacity = 1),
                   name = paste0("Twin pair ", pair), showlegend = FALSE,
                   legendgroup = paste0("pair_", pair),
                   hovertemplate = paste0('Twin pair ', pair, '<br>SGA<br>',
                                          'PC1: %{x:.2f}<br>PC2: %{y:.2f}<br>PC3: %{z:.2f}<extra></extra>'))
}

# Calculate axis ranges with padding
pc1_range      <- range(pc_scores$PC1)
pc2_range      <- range(pc_scores$PC2)
pc3_range      <- range(pc_scores$PC3)
padding_factor <- 0.15

# Layout configuration
fig <- layout(fig,
              scene = list(
                xaxis = list(
                  title    = list(text = paste0("PC1 (", percentVar[1], "%)"),
                                  font = list(size = 20, color = 'black')),
                  tickfont = list(size = 16, color = 'black'),
                  range    = c(pc1_range[1] - diff(pc1_range) * padding_factor,
                               pc1_range[2] + diff(pc1_range) * padding_factor),
                  showgrid = TRUE, gridcolor = 'rgba(120, 120, 120, 1)', gridwidth = 2),
                yaxis = list(
                  title    = list(text = paste0("PC2 (", percentVar[2], "%)"),
                                  font = list(size = 20, color = 'black')),
                  tickfont = list(size = 16, color = 'black'),
                  range    = c(pc2_range[1] - diff(pc2_range) * padding_factor,
                               pc2_range[2] + diff(pc2_range) * padding_factor),
                  showgrid = TRUE, gridcolor = 'rgba(120, 120, 120, 1)', gridwidth = 2),
                zaxis = list(
                  title    = list(text = paste0("PC3 (", percentVar[3], "%)"),
                                  font = list(size = 20, color = 'black')),
                  tickfont = list(size = 16, color = 'black'),
                  range    = c(pc3_range[1] - diff(pc3_range) * padding_factor,
                               pc3_range[2] + diff(pc3_range) * padding_factor),
                  showgrid = TRUE, gridcolor = 'rgba(120, 120, 120, 1)', gridwidth = 2),
                camera      = list(eye = list(x = 1.8, y = 1.8, z = 1.5)),
                aspectmode  = 'cube'),
              paper_bgcolor = 'white',
              plot_bgcolor  = 'white')

# Save PCA plot
saveWidget(fig, file.path(OUTPUT_DIR, "Adipocyte_3D_PCA.html"), selfcontained = TRUE)

cat("\n✓ PCA plot saved as HTML\n")
cat("  To export as high-resolution image:\n")
cat("  1. Open the HTML file in a browser\n")
cat("  2. Adjust the view as desired\n")
cat("  3. Click the camera icon and select 'Download plot as SVG'\n")
cat("  4. Open in Adobe Illustrator and export as needed\n")

#=========================================================================================================================================================================================
# 4. VOLCANO PLOT

# Count significant genes
significant_genes <- subset(res_ordered, padj < 0.05 & abs(log2FoldChange) > 1)
cat("Significant genes (padj < 0.05, |log2FC| > 1):", nrow(significant_genes), "\n")

# Create custom color vector
