# RNA-SEQ ANALYSIS PIPELINE: ADIPOGENIC CULTURE SAMPLES
# Comparison: SGA vs AGA
# Design: Paired analysis (5 twin pairs, 10 samples total)
#
# Pipeline outline:
#   1. Data preprocessing and gene annotation (ENSEMBL to Gene Symbol)
#   2. Differential expression analysis (DESeq2)
#   3. Principal Component Analysis (3D PCA)          -> Figure B
#   4. Volcano Plot visualization                     -> Figure C
#   5. Gene Set Enrichment Analysis (GSEA) - GO:BP    -> Figure D + E
#   6. Gene expression plots: DLK1, PPARG, FABP4      -> Figure 4
#
# Note: 5 of the original 6 UCMSC twin pairs were used for adipogenic
#       differentiation (pair 1 excluded). PAIR_MAPPING renumbers
#       original IDs (2,3,4,6,7) to display labels (1,2,3,4,5).
#
# Author: Analia Yogi
# Date:   January 2026
# Data:   DDBJ accession PRJDB40126

#=============================================================================
# Clear environment
rm(list = ls())
gc()

#=============================================================================
# CONFIGURATION


OUTPUT_DIR <- "Adipocyte_Analysis_Results_20260413"
if (!dir.exists(OUTPUT_DIR)) {
  dir.create(OUTPUT_DIR, recursive = TRUE)
  cat("Directory created:", OUTPUT_DIR, "\n")
}

# Twin pair mapping: original sample IDs -> display labels
# Adipocyte dataset uses pairs 2,3,4,6,7 (pair 1 not differentiated)
PAIR_MAPPING <- c("2" = "1", "3" = "2", "4" = "3", "6" = "4", "7" = "5")
N_PAIRS <- 5

# Unified color palette for twin pairs (used in PCA, heatmap, gene expression)
PAIR_COLORS <- c("1" = "#E41A1C",   # red
                 "2" = "#377EB8",   # blue
                 "3" = "#4DAF4A",   # green
                 "4" = "#FF7F00",   # orange
                 "5" = "#984EA3")   # purple

set.seed(42)

#=============================================================================
# LOAD LIBRARIES


library(biomaRt)
library(dplyr)
library(ggplot2)
library(DESeq2)
library(RColorBrewer)
library(EnhancedVolcano)
library(plotly)
library(patchwork)
library(fgsea)
library(msigdbr)
library(ComplexHeatmap)
library(circlize)
library(grid)
library(gridExtra)
library(cowplot)
library(htmlwidgets)
library(extrafont)

#=============================================================================
# 1. DATA PREPROCESSING
#=============================================================================

raw_counts <- read.table("adipocyte_raw_counts_paired.csv",
                         header     = TRUE,
                         row.names  = 1,
                         sep        = ";",
                         check.names = FALSE)

cat("Data dimensions:", dim(raw_counts)[1], "genes x", dim(raw_counts)[2], "samples\n")
cat("Sample names:", paste(colnames(raw_counts), collapse = ", "), "\n")

# Remove ENSEMBL version numbers (e.g. ENSG00000000003.15 -> ENSG00000000003)
ensembl_ids       <- rownames(raw_counts)
ensembl_ids_clean <- gsub("\\.\\d+$", "", ensembl_ids)
cat("Total genes:", length(ensembl_ids), "\n")
cat("IDs with version numbers removed:", sum(ensembl_ids != ensembl_ids_clean), "\n")

# Retrieve HGNC annotations via biomaRt
cat("Connecting to biomaRt...\n")
mart <- useMart("ensembl", dataset = "hsapiens_gene_ensembl")
annotations <- getBM(
  attributes = c("ensembl_gene_id", "hgnc_symbol", "gene_biotype", "description"),
  filters    = "ensembl_gene_id",
  values     = ensembl_ids_clean,
  mart       = mart
)

# Build mapping table
mapping_table <- data.frame(
  ensembl_id_original = ensembl_ids,
  ensembl_id_clean    = ensembl_ids_clean,
  gene_symbol         = NA,
  gene_biotype        = NA,
  description         = NA,
  has_symbol          = FALSE,
  is_protein_coding   = FALSE,
  stringsAsFactors    = FALSE
)

for (i in seq_len(nrow(mapping_table))) {
  m <- annotations[annotations$ensembl_gene_id == mapping_table$ensembl_id_clean[i], ]
  if (nrow(m) > 0) {
    m <- m[1, ]
    mapping_table$gene_symbol[i]       <- m$hgnc_symbol
    mapping_table$gene_biotype[i]      <- m$gene_biotype
    mapping_table$description[i]       <- m$description
    mapping_table$has_symbol[i]        <- m$hgnc_symbol != ""
    mapping_table$is_protein_coding[i] <- m$gene_biotype == "protein_coding"
  }
}

# Keep protein-coding genes with valid symbols; remove duplicates
valid_genes        <- mapping_table[mapping_table$has_symbol &
                                      mapping_table$is_protein_coding &
                                      !is.na(mapping_table$has_symbol), ]
valid_genes_unique <- valid_genes[!duplicated(valid_genes$gene_symbol), ]
cat("Unique protein-coding genes:", nrow(valid_genes_unique), "\n")

filtered_counts             <- raw_counts[valid_genes_unique$ensembl_id_original, ]
rownames(filtered_counts)   <- valid_genes_unique$gene_symbol

if (sum(duplicated(rownames(filtered_counts))) == 0) {
  cat("✓ No duplicates in final data\n")
} else {
  cat("✗ Duplicates still present - check code\n")
}

# Sample structure
pairs_detected <- data.frame(
  sample     = colnames(filtered_counts),
  condition  = ifelse(grepl("^B", colnames(filtered_counts)), "AGA", "SGA"),
  pair_number = as.numeric(gsub("[BS]", "", colnames(filtered_counts))),
  stringsAsFactors = FALSE
)
print(pairs_detected)

# Save preprocessing outputs
write.csv(mapping_table,    file.path(OUTPUT_DIR, "Adipocyte_ensembl_to_symbol_mapping.csv"), row.names = FALSE)
write.csv(filtered_counts,  file.path(OUTPUT_DIR, "Adipocyte_counts_with_gene_symbols.csv"),  row.names = TRUE)
write.csv(pairs_detected,   file.path(OUTPUT_DIR, "Adipocyte_sample_structure.csv"),           row.names = FALSE)

#=============================================================================
# 2. DIFFERENTIAL EXPRESSION ANALYSIS (DESeq2)
#=============================================================================

# Filter: remove zero-count genes; keep genes with >= 10 counts in >= 5 samples
filtered_counts_nonzero <- filtered_counts[rowSums(filtered_counts) > 0, ]
keep          <- rowSums(filtered_counts_nonzero >= 10) >= 5
counts_matrix <- filtered_counts_nonzero[keep, ]
cat("Genes after low-expression filtering:", nrow(counts_matrix), "\n")

# Sample metadata
sample_info <- data.frame(
  sample_id  = colnames(counts_matrix),
  condition  = ifelse(grepl("^B", colnames(counts_matrix)), "AGA", "SGA"),
  twin_pair  = as.factor(gsub("[BS]", "", colnames(counts_matrix))),
  row.names  = colnames(counts_matrix)
)
sample_info$condition <- factor(sample_info$condition, levels = c("AGA", "SGA"))
sample_info$twin_pair <- factor(sample_info$twin_pair)
print(sample_info)

# DESeq2 paired design: twin_pair as blocking factor
dds <- DESeqDataSetFromMatrix(
  countData = counts_matrix,
  colData   = sample_info,
  design    = ~ twin_pair + condition
)

cat("\n=== RUNNING DESeq2 ===\n")
dds <- DESeq(dds)

res         <- results(dds, contrast = c("condition", "SGA", "AGA"))
res_ordered <- res[order(res$padj), ]

cat("\nResults summary:\n")
summary(res)
cat("\nTop 10 most significant genes:\n")
print(head(res_ordered, 10))

# Export results
write.csv(as.data.frame(res_ordered),
          file.path(OUTPUT_DIR, "Adipocyte_deseq2_results.csv"), row.names = TRUE)
write.table(as.data.frame(res_ordered),
            file.path(OUTPUT_DIR, "Adipocyte_deseq2_results.txt"),
            sep = "\t", dec = ".", row.names = TRUE, col.names = NA, quote = FALSE)

normalized_counts <- counts(dds, normalized = TRUE)
write.table(normalized_counts,
            file.path(OUTPUT_DIR, "Adipocyte_normalized_counts.txt"),
            sep = "\t", quote = FALSE, row.names = TRUE, col.names = TRUE, dec = ".")

#=============================================================================
# 3. PRINCIPAL COMPONENT ANALYSIS (3D PCA)  ->  Figure B
#=============================================================================

vsd       <- vst(dds, blind = FALSE)
pca       <- prcomp(t(assay(vsd)))
pc_scores <- as.data.frame(pca$x[, 1:3])
percentVar <- round(100 * pca$sdev^2 / sum(pca$sdev^2), 1)

pc_scores$condition <- colData(vsd)$condition
pc_scores$twin_pair <- colData(vsd)$twin_pair

pc_scores$twin_pair_display <- factor(
  PAIR_MAPPING[as.character(pc_scores$twin_pair)],
  levels = c("1", "2", "3", "4", "5")
)

# Use PAIR_COLORS (defined in CONFIGURATION) for consistency with heatmap/gene plots
pair_colors_pca <- unname(PAIR_COLORS)

fig <- plot_ly()
for (pair in levels(pc_scores$twin_pair_display)) {
  aga       <- subset(pc_scores, twin_pair_display == pair & condition == "AGA")
  sga       <- subset(pc_scores, twin_pair_display == pair & condition == "SGA")
  color_idx <- which(levels(pc_scores$twin_pair_display) == pair)
  
  fig <- add_trace(fig, data = aga, x = ~PC1, y = ~PC2, z = ~PC3,
                   type = 'scatter3d', mode = 'markers',
                   marker = list(symbol = 'circle', size = 16, color = pair_colors_pca[color_idx],
                                 line = list(color = 'black', width = 7), opacity = 1),
                   name = paste0("Twin pair ", pair), showlegend = FALSE,
                   legendgroup = paste0("pair_", pair),
                   hovertemplate = paste0('Twin pair ', pair, '<br>AGA<br>PC1: %{x:.2f}<br>PC2: %{y:.2f}<br>PC3: %{z:.2f}<extra></extra>'))
  
  fig <- add_trace(fig, data = sga, x = ~PC1, y = ~PC2, z = ~PC3,
                   type = 'scatter3d', mode = 'markers',
                   marker = list(symbol = 'diamond', size = 16, color = pair_colors_pca[color_idx],
                                 line = list(color = 'black', width = 7), opacity = 1),
                   name = paste0("Twin pair ", pair), showlegend = FALSE,
                   legendgroup = paste0("pair_", pair),
                   hovertemplate = paste0('Twin pair ', pair, '<br>SGA<br>PC1: %{x:.2f}<br>PC2: %{y:.2f}<br>PC3: %{z:.2f}<extra></extra>'))
}

pc1_range <- range(pc_scores$PC1); pc2_range <- range(pc_scores$PC2); pc3_range <- range(pc_scores$PC3)
padding_factor <- 0.15

fig <- layout(fig,
              scene = list(
                xaxis = list(title = list(text = paste0("PC1 (", percentVar[1], "%)"), font = list(size = 20, color = 'black')),
                             tickfont = list(size = 16, color = 'black'),
                             range = c(pc1_range[1] - diff(pc1_range) * padding_factor, pc1_range[2] + diff(pc1_range) * padding_factor),
                             showgrid = TRUE, gridcolor = 'rgba(120,120,120,1)', gridwidth = 2),
                yaxis = list(title = list(text = paste0("PC2 (", percentVar[2], "%)"), font = list(size = 20, color = 'black')),
                             tickfont = list(size = 16, color = 'black'),
                             range = c(pc2_range[1] - diff(pc2_range) * padding_factor, pc2_range[2] + diff(pc2_range) * padding_factor),
                             showgrid = TRUE, gridcolor = 'rgba(120,120,120,1)', gridwidth = 2),
                zaxis = list(title = list(text = paste0("PC3 (", percentVar[3], "%)"), font = list(size = 20, color = 'black')),
                             tickfont = list(size = 16, color = 'black'),
                             range = c(pc3_range[1] - diff(pc3_range) * padding_factor, pc3_range[2] + diff(pc3_range) * padding_factor),
                             showgrid = TRUE, gridcolor = 'rgba(120,120,120,1)', gridwidth = 2),
                camera = list(eye = list(x = 1.8, y = 1.8, z = 1.5)),
                aspectmode = 'cube'),
              paper_bgcolor = 'white', plot_bgcolor = 'white')

saveWidget(fig, file.path(OUTPUT_DIR, "Adipocyte_3D_PCA.html"), selfcontained = TRUE)
cat("✓ PCA saved as HTML (export manually from browser as SVG)\n")

#=============================================================================
# 4. VOLCANO PLOT  ->  Figure C
#=============================================================================

keyvals <- ifelse(
  res$log2FoldChange < -1 & res$pvalue < 0.05, '#0066CC',
  ifelse(res$log2FoldChange > 1 & res$pvalue < 0.05, '#CC0000',
         ifelse(abs(res$log2FoldChange) > 1, 'gray70', 'gray80')))
keyvals[is.na(keyvals)] <- 'gray80'
names(keyvals)[keyvals == '#CC0000'] <- 'Upregulated'
names(keyvals)[keyvals == '#0066CC'] <- 'Downregulated'
names(keyvals)[keyvals == 'gray70']  <- 'Log2 FC'
names(keyvals)[keyvals == 'gray80']  <- 'Not significant'

volcano_plot <- EnhancedVolcano(res,
                                lab           = NA,
                                x             = 'log2FoldChange',
                                y             = 'pvalue',
                                title         = 'SGA vs. AGA',
                                subtitle      = '',
                                caption       = '',
                                pCutoff       = 0.05,
                                FCcutoff      = 1,
                                pointSize     = 3.5,
                                colCustom     = keyvals,
                                colAlpha      = 0.8,
                                drawConnectors = FALSE,
                                xlim          = c(-4, 4),
                                ylim          = c(0, max(-log10(res$pvalue), na.rm = TRUE) * 1.1),
                                xlab          = bquote(~Log[2]~ "Fold Change"),
                                ylab          = bquote(~-Log[10]~ "(" * italic(P) * "-value)"),
                                legendPosition = 'right',
                                legendLabSize  = 16,
                                legendIconSize = 6.0,
                                hlineCol = 'black', hlineType = 'dashed', hlineWidth = 0.5,
                                vlineCol = 'black', vlineType = 'dashed', vlineWidth = 0.5,
                                gridlines.major = FALSE, gridlines.minor = FALSE,
                                border = 'full', borderWidth = 0.75, borderColour = 'black') +
  theme(
    text          = element_text(family = "Helvetica", color = "black", face = "bold"),
    plot.title    = element_text(size = 24, face = "bold", hjust = 0.5),
    axis.title.x  = element_text(size = 22, face = "bold", margin = margin(t = 15)),
    axis.title.y  = element_text(size = 22, face = "bold", margin = margin(r = 15)),
    axis.text     = element_text(size = 18, color = "black", face = "bold"),
    legend.title  = element_blank(),
    legend.text   = element_text(size = 16, face = "bold"),
    legend.position = "right",
    panel.background = element_rect(fill = "white", color = "black", linewidth = 0.75),
    panel.grid    = element_blank(),
    plot.background  = element_rect(fill = "white", color = NA),
    aspect.ratio  = 0.9
  )

ggsave(file.path(OUTPUT_DIR, "Adipocyte_volcano_plot.png"),  volcano_plot, width = 10, height = 9, dpi = 300, bg = "white")
ggsave(file.path(OUTPUT_DIR, "Adipocyte_volcano_plot.pdf"),  volcano_plot, width = 10, height = 9, device = "pdf")
ggsave(file.path(OUTPUT_DIR, "Adipocyte_volcano_plot.tiff"), volcano_plot, width = 10, height = 9, dpi = 300, compression = "lzw")
cat("✓ Volcano plot saved\n")

#=============================================================================
# 5. GSEA GO:BP  ->  Figure D (bar plot) + Figure E (leading edge heatmap)
#=============================================================================

GSEA_DIR    <- file.path(OUTPUT_DIR, "GSEA_GO_BP")
HEATMAP_DIR <- file.path(GSEA_DIR,   "heatmaps_leading_edge")
if (!dir.exists(GSEA_DIR))    dir.create(GSEA_DIR,    recursive = TRUE)
if (!dir.exists(HEATMAP_DIR)) dir.create(HEATMAP_DIR, recursive = TRUE)

# ── Parameters ───────────────────────────────────────────────────────────────
MIN_SIZE       <- 15
MAX_SIZE       <- 500
FDR_CUTOFF     <- 0.05
N_TOP          <- 10    # pathways in bar plot
N_TOP_HEATMAP  <- 1     # top UP pathway for leading edge heatmap
CELL_HEIGHT_MM <- 2.5

# ── Gene ranking (Wald statistic) ────────────────────────────────────────────
res_gsea  <- results(dds, contrast = c("condition", "SGA", "AGA"))
gene_list <- res_gsea$stat
names(gene_list) <- rownames(res_gsea)
gene_list <- sort(gene_list[!is.na(gene_list)], decreasing = TRUE)
cat("Genes ranked:", length(gene_list), "\n")

# ── GO:BP gene sets ──────────────────────────────────────────────────────────
go_bp_sets    <- msigdbr(species = "Homo sapiens", category = "C5", subcategory = "GO:BP") %>%
  dplyr::select(gs_name, gene_symbol)
pathways_list <- split(go_bp_sets$gene_symbol, go_bp_sets$gs_name)
cat("GO:BP pathways loaded:", length(pathways_list), "\n")

# ── Run GSEA ─────────────────────────────────────────────────────────────────
fgsea_results <- fgsea(pathways = pathways_list, stats = gene_list,
                       minSize = MIN_SIZE, maxSize = MAX_SIZE, nproc = 1)
fgsea_results <- fgsea_results[order(fgsea_results$padj), ]

cat("Significant (FDR <", FDR_CUTOFF, "):",
    sum(fgsea_results$padj < FDR_CUTOFF, na.rm = TRUE), "\n")

# Export full results
fgsea_export <- fgsea_results
if (is.list(fgsea_export$leadingEdge))
  fgsea_export$leadingEdge <- sapply(fgsea_export$leadingEdge, paste, collapse = ", ")
write.csv(fgsea_export, file.path(GSEA_DIR, "GSEA_GOBP_Results_All.csv"), row.names = FALSE)
write.table(fgsea_export, file.path(GSEA_DIR, "GSEA_GOBP_Results_All.txt"),
            sep = "\t", quote = FALSE, row.names = FALSE)
save(fgsea_results, gene_list, file = file.path(GSEA_DIR, "GSEA_GOBP_Results.RData"))

# ── Filter (FDR < 0.05) ──────────────────────────────────────────────────────
significant_pathways <- fgsea_results[fgsea_results$padj < FDR_CUTOFF, ]
top_up   <- significant_pathways %>% filter(NES > 0) %>% arrange(desc(NES)) %>% head(N_TOP)
top_down <- significant_pathways %>% filter(NES < 0) %>% arrange(NES)        %>% head(N_TOP)
cat("Top UP:", nrow(top_up), "| Top DOWN:", nrow(top_down), "\n")

# ── Helper: clean pathway names ───────────────────────────────────────────────
clean_pathway_names <- function(names, max_chars = 50) {
  cleaned <- gsub("^GOBP_", "", names)
  cleaned <- gsub("_", " ", cleaned)
  cleaned <- tools::toTitleCase(tolower(cleaned))
  ifelse(nchar(cleaned) > max_chars,
         paste0(substr(cleaned, 1, max_chars - 3), "..."), cleaned)
}

# ── Figure D: GSEA bar plot ───────────────────────────────────────────────────
plot_data <- rbind(
  top_up   %>% mutate(direction = "Up"),
  top_down %>% mutate(direction = "Down")
) %>% mutate(
  pathway_clean = clean_pathway_names(pathway, 45),
  significance  = case_when(
    padj < 0.001 ~ "***", padj < 0.01 ~ "**", padj < 0.05 ~ "*", TRUE ~ ""
  )
)

bar_plot <- ggplot(plot_data, aes(x = NES, y = reorder(pathway_clean, NES), fill = NES)) +
  geom_bar(stat = "identity", width = 0.8, color = "black", linewidth = 0.3) +
  geom_text(aes(label = significance,
                x     = ifelse(NES > 0, NES + 0.08, NES - 0.08)),
            hjust = ifelse(plot_data$NES > 0, 0, 1), size = 4, fontface = "bold") +
  scale_fill_gradient2(low = "#2166AC", mid = "white", high = "#D73027",
                       midpoint = 0, name = "NES") +
  geom_vline(xintercept = 0, color = "black", linewidth = 0.8) +
  labs(title   = "GSEA(GO:BP)",
       x       = "Normalized enrichment score\n(NES)",
       y       = "",
       caption = "*FDR < 0.05   **FDR < 0.01   ***FDR < 0.001") +
  theme_classic(base_size = 12) +
  theme(
    plot.title         = element_text(size = 16, face = "bold", hjust = 0.5),
    axis.title.x       = element_text(size = 12, face = "bold", margin = margin(t = 10)),
    axis.text.y        = element_text(size = 10, color = "black"),
    axis.text.x        = element_text(size = 10, color = "black"),
    legend.position    = "right",
    plot.caption       = element_text(size = 9, hjust = 1, color = "gray50"),
    panel.grid.major.x = element_line(color = "gray90", linewidth = 0.3),
    plot.margin        = margin(20, 20, 20, 20)
  )

ggsave(file.path(GSEA_DIR, "GSEA_GOBP_Barplot.png"),
       bar_plot, width = 12, height = 10, dpi = 300, bg = "white")
ggsave(file.path(GSEA_DIR, "GSEA_GOBP_Barplot.pdf"),
       bar_plot, width = 12, height = 10, device = cairo_pdf)
cat("✓ GSEA bar plot saved\n")

# Export top pathway summary
top_up_export   <- top_up
top_down_export <- top_down
if (is.list(top_up_export$leadingEdge))
  top_up_export$leadingEdge   <- sapply(top_up_export$leadingEdge,   paste, collapse = ", ")
if (is.list(top_down_export$leadingEdge))
  top_down_export$leadingEdge <- sapply(top_down_export$leadingEdge, paste, collapse = ", ")
summary_table <- rbind(
  top_up_export   %>% mutate(Direction = "Up in SGA"),
  top_down_export %>% mutate(Direction = "Down in SGA")
) %>% mutate(Pathway_Clean = clean_pathway_names(pathway, 60)) %>%
