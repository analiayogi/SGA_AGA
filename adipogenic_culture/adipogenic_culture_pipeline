# Twin pair mapping (Adipocyte: 5 pairs)
PAIR_MAPPING <- c("2" = "1", "3" = "2", "4" = "3", "6" = "4", "7" = "5")

# Color palette (colorblind-friendly)
PAIR_COLORS <- c(
